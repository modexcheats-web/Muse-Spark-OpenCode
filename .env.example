# Copie para .env e ajuste. Nao versione este arquivo.
# Valor do cookie hatch_sess (recomendado: renovar no navegador e colar aqui)
# MUSE_HATCH_SESS=cole_o_valor_do_cookie_hatch_sess

# Alternativa: arquivo JSON exportado com os cookies do muse.ai
MUSE_COOKIES_FILE=C:/caminho/para/muse.ai.cookies.json

# Chave local do proxy. O instalador gera automaticamente; se estiver vazia,
# o proxy gera .muse-proxy-key na primeira execucao.
# MUSE_PROXY_API_KEY=troque-esta-chave

# Origens de navegador permitidas para CORS, separadas por virgula.
# Vazio = nenhuma (o OpenCode Desktop nao precisa de CORS).
# Use * apenas se souber o que esta fazendo.
# MUSE_CORS_ORIGINS=http://localhost:3000

PORT=8790
HOST=127.0.0.1
MUSE_MODEL=muse-spark
MUSE_TIMEOUT_MS=180000

# Isolamento de contexto no Muse:
#   request = cada requisicao do OpenCode cria uma thread nova e apaga no fim (padrao)
#   session = uma thread por conversa do OpenCode (detectada pelo primeiro prompt)
#   legacy  = reaproveita a sessao fixa de .muse-session.json (comportamento antigo)
MUSE_SESSION_MODE=request

# Em request, mantenha as threads no Muse para depuracao (nao apaga no fim).
MUSE_KEEP_SESSIONS=false

# Raciocinio exibido no OpenCode:
#   summary = pede ao modelo um resumo de raciocinio e o envia como reasoning_content (padrao)
#   off     = nao envia raciocinio
# O Muse nao expoe chain-of-thought nativo; summary e um resumo gerado pelo proprio modelo.
MUSE_REASONING_MODE=summary

# Raiz do projeto local que as device commands podem acessar.
# Se vazio, o proxy usa o "Working directory:" do system prompt do OpenCode.
# MUSE_WORKSPACE=C:/caminho/do/projeto

# Permite que o Muse execute comandos na sua maquina (tests, builds, git).
# Nao e um sandbox: o comando pode acessar caminhos fora do projeto.
# Variaveis MUSE_* (incluindo cookies) sao removidas do ambiente do comando.
# Use false para desabilitar shell.exec.
MUSE_ENABLE_SHELL=true

# Device id das device commands. O proxy salva um UUID estavel em
# .muse-device.json e reutiliza o no "Muse Local Proxy" existente.
# Use MUSE_DEVICE_ID apenas para forcar um UUID valido.
# MUSE_DEVICE_ID=00000000-0000-4000-8000-000000000000
# MUSE_DEVICE_FILE=C:/caminho/para/.muse-device.json

# Limpeza explicita de nos duplicados/offline no Muse:
#   node scripts/muse-devices.js list
#   node scripts/muse-devices.js prune --yes

# Opcional: fixa a sessao do Muse no modo legacy (tambem persistida em .muse-session.json).
# Nos modos request/session cada conversa cria a propria thread.
# MUSE_SESSION_ID=<uuid-da-sessao-legacy>
